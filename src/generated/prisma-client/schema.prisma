// ---------------------------------------------------------------------------
// Sprint 2 — Curriculum Configuration, Semester/Term, Academic Calendar
// Curriculum: Program + Academic Year structure; courses mapped via CurriculumCourse
// Semester: periods within Academic Year
// CalendarEvent: institution calendar events tied to Academic Year (optional Semester)
// ---------------------------------------------------------------------------

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SemesterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
  ARCHIVED
}

enum CalendarEventType {
  HOLIDAY
  BREAK
  EXAM
  EVENT
  OTHER
}

model Curriculum {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  institutionId  String           @map("institution_id") @db.Uuid
  programId      String           @map("program_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  code           String           @db.VarChar(40)
  name           String           @db.VarChar(200)
  description    String?          @db.VarChar(500)
  status         CurriculumStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution  Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  courses      CurriculumCourse[]

  @@unique([tenantId, programId, academicYearId, code])
  @@index([tenantId, institutionId, status])
  @@index([tenantId, academicYearId, status])
  @@map("curricula")
}

model CurriculumCourse {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  curriculumId String   @map("curriculum_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  sequence     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, courseId])
  @@index([tenantId, curriculumId])
  @@map("curriculum_courses")
}

model Semester {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  institutionId  String         @map("institution_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  code           String         @db.VarChar(30)
  name           String         @db.VarChar(100)
  sequence       Int            @default(1)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  status         SemesterStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  calendarEvents CalendarEvent[]

  @@unique([tenantId, academicYearId, code])
  @@index([tenantId, academicYearId, status])
  @@index([tenantId, institutionId, status])
  @@map("semesters")
}

model CalendarEvent {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  institutionId  String              @map("institution_id") @db.Uuid
  academicYearId String              @map("academic_year_id") @db.Uuid
  semesterId     String?             @map("semester_id") @db.Uuid
  title          String              @db.VarChar(200)
  eventType      CalendarEventType   @default(EVENT) @map("event_type")
  description    String?             @db.VarChar(500)
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime            @map("end_date") @db.Date
  status         CalendarEventStatus @default(SCHEDULED)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  semester     Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@index([tenantId, academicYearId, startDate])
  @@index([tenantId, institutionId, status])
  @@index([tenantId, eventType])
  @@map("calendar_events")
}

