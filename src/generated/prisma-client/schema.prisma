  institution     Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  program         Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  subjects        Subject[]
  curriculumItems CurriculumCourse[]

  @@unique([tenantId, programId, code])
  @@index([tenantId, programId, status])
  @@index([tenantId, institutionId, status])
  @@map("courses")
}

model Subject {
