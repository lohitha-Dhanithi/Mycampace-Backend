// AI Chrona / EduCore — Prisma schema
// Platform Foundation + Phase 2 Authentication entities
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform / Tenant
// ---------------------------------------------------------------------------

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @db.VarChar(50)
  name             String       @db.VarChar(255)
  status           TenantStatus @default(ACTIVE)
  subscriptionTier String?      @map("subscription_tier") @db.VarChar(50)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  users                      User[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  activationTokens           ActivationToken[]
  loginHistory               LoginHistory[]
  mfaFactors                 MfaFactor[]
  externalIdentities         ExternalIdentity[]
  identityProviders          IdentityProvider[]
  roles                      Role[]
  userRoles                  UserRole[]
  registrationRequests       RegistrationRequest[]
  institutions               Institution[]
  campuses                   Campus[]
  userCampusAssignments      UserCampusAssignment[]
  admissionApplications      AdmissionApplication[]
  parentStudentRelationships ParentStudentRelationship[]
  brandingProfiles           BrandingProfile[]
  brandingAssets             BrandingAsset[]
  auditLogs                  AuditLog[]
  academicYears              AcademicYear[]
  departments                Department[]
  programs                   Program[]
  courses                    Course[]
  subjects                   Subject[]
  curricula                  Curriculum[]
  semesters                  Semester[]
  calendarEvents             CalendarEvent[]
  hrmsCategories             HrmsCategory[]
  hrmsDepartments            HrmsDepartment[]
  staff                      Staff[]
  staffDocuments             StaffDocument[]
  serviceEvents              ServiceEvent[]
  certifications             Certification[]
  leaveTypes                 LeaveType[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  leaveApprovalSteps         LeaveApprovalStep[]
  shifts                     Shift[]
  shiftAssignments           ShiftAssignment[]
  attendanceRecords          AttendanceRecord[]
  appraisalCycles            AppraisalCycle[]
  appraisalMetricTemplates   AppraisalMetricTemplate[]
  appraisalReviews           AppraisalReview[]
  appraisalReviewMetrics     AppraisalReviewMetric[]
  appraisalComments          AppraisalComment[]

  @@unique([code])
  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  PENDING
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  email            String      @db.VarChar(255)
  mobile           String?     @db.VarChar(20)
  passwordHash     String?     @map("password_hash") @db.VarChar(255)
  personaType      PersonaType @map("persona_type")
  status           UserStatus  @default(ACTIVE)
  mfaEnabled       Boolean     @default(false) @map("mfa_enabled")
  failedLoginCount Int         @default(0) @map("failed_login_count")
  lockedUntil      DateTime?   @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime?   @map("last_login_at") @db.Timestamptz
  activatedAt      DateTime?   @map("activated_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  activationTokens      ActivationToken[]
  loginHistory          LoginHistory[]
  mfaFactors            MfaFactor[]
  externalIdentities    ExternalIdentity[]
  userRoles             UserRole[]
  registrationRequests  RegistrationRequest[]
  admissionApplications AdmissionApplication[]
  parentRelationships   ParentStudentRelationship[] @relation("ParentUser")
  studentRelationships  ParentStudentRelationship[] @relation("StudentUser")
  campusAssignments     UserCampusAssignment[]
  staff                 Staff[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

enum PersonaType {
  STAFF
  STUDENT
  PARENT
  EXTERNAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Auth: Refresh tokens (hashed at rest; rotation / session tracking)
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  familyId   String    @map("family_id") @db.Uuid
  deviceInfo String?   @map("device_info") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tokenHash])
  @@index([userId, tenantId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Auth: Password reset tokens (hashed, single-use, expiring)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Auth: Account activation tokens (hashed, single-use, expiring)
// ---------------------------------------------------------------------------

model ActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("activation_tokens")
}

// ---------------------------------------------------------------------------
// Auth: Login history (append-only audit of authentication attempts)
// ---------------------------------------------------------------------------

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  email     String?  @db.VarChar(255)
  success   Boolean
  reason    String?  @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("login_history")
}

// ---------------------------------------------------------------------------
// MFA: Permanent factors (TOTP secrets encrypted at rest — never plaintext)
// ---------------------------------------------------------------------------

model MfaFactor {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  type            MfaFactorType
  status          MfaFactorStatus @default(PENDING)
  displayName     String?         @map("display_name") @db.VarChar(100)
  /// AES-GCM encrypted TOTP secret (base64 ciphertext blob). Never store plaintext.
  encryptedSecret String?         @map("encrypted_secret") @db.Text
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz
  lastUsedAt      DateTime?       @map("last_used_at") @db.Timestamptz
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, tenantId, status])
  @@index([userId, type])
  @@map("mfa_factors")
}

enum MfaFactorType {
  TOTP
  SMS
  EMAIL
  WEBAUTHN
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  DISABLED
  REVOKED
}

// ---------------------------------------------------------------------------
// SSO: External identity link (provider + subject is the stable key)
// ---------------------------------------------------------------------------

model ExternalIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  provider        String    @db.VarChar(50)
  providerSubject String    @map("provider_subject") @db.VarChar(255)
  email           String?   @db.VarChar(255)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@map("external_identities")
}

// ---------------------------------------------------------------------------
// SSO: Tenant-scoped identity provider configuration (secrets via env/secrets mgr)
// ---------------------------------------------------------------------------

model IdentityProvider {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  provider    String   @db.VarChar(50)
  enabled     Boolean  @default(false)
  issuer      String?  @db.VarChar(512)
  clientId    String?  @map("client_id") @db.VarChar(255)
  /// Reference key into secrets manager / env — NOT the secret value
  secretRef   String?  @map("secret_ref") @db.VarChar(255)
  metadataUrl String?  @map("metadata_url") @db.VarChar(1024)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled])
  @@map("identity_providers")
}

// ---------------------------------------------------------------------------
// Role catalog (authorization identity — NOT personaType)
// Permissions / RolePermission deferred to RBAC phase.
// ---------------------------------------------------------------------------

model Role {
  id                              String   @id @default(uuid()) @db.Uuid
  /// Stable machine code e.g. STUDENT, PRINCIPAL — never use displayName for auth
  code                            String   @db.VarChar(50)
  displayName                     String   @map("display_name") @db.VarChar(100)
  description                     String?  @db.VarChar(500)
  /// SELF | INVITATION | ADMIN_ONLY
  registrationMode                String   @map("registration_mode") @db.VarChar(30)
  selfRegistrationAllowed         Boolean  @default(false) @map("self_registration_allowed")
  invitationRequired              Boolean  @default(true) @map("invitation_required")
  administratorAssignmentRequired Boolean  @default(false) @map("administrator_assignment_required")
  isSystem                        Boolean  @default(true) @map("is_system")
  isActive                        Boolean  @default(true) @map("is_active")
  /// Optional default persona for UX only — not authorization
  defaultPersonaType              String?  @map("default_persona_type") @db.VarChar(30)
  /// null = platform-wide catalog entry; set for tenant overrides later
  tenantId                        String?  @map("tenant_id") @db.Uuid
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles            UserRole[]
  registrationRequests RegistrationRequest[]
  rolePermissions      RolePermission[]

  @@unique([code, tenantId])
  @@index([isActive, selfRegistrationAllowed])
  @@map("roles")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// PENDING | ACTIVE | REVOKED
  status     String    @default("PENDING") @db.VarChar(20)
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz
  assignedBy String?   @map("assigned_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId, roleId])
  @@index([userId, status])
  @@map("user_roles")
}

/// Privileged / invitation registration requests — does NOT grant role by itself
model RegistrationRequest {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.VarChar(255)
  requestedRoleId String    @map("requested_role_id") @db.Uuid
  /// PENDING | APPROVED | REJECTED | EXPIRED
  status          String    @default("PENDING") @db.VarChar(20)
  /// Optional link to user if pre-provisioned
  userId          String?   @map("user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedRole Role   @relation(fields: [requestedRoleId], references: [id], onDelete: Restrict)
  user          User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([status])
  @@map("registration_requests")
}

// ---------------------------------------------------------------------------
// RBAC foundation — Permission catalog + RolePermission
// Full admin UI / evaluation engine expansion deferred.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable code e.g. identity.user.read — never use displayName for auth
  code        String   @unique @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(150)
  description String?  @db.VarChar(500)
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(30)
  isSystem    Boolean  @default(true) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@index([module, isActive])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Institution — belongs to exactly one Tenant (Sprint 1 Institution Management)
// Campus deferred until source requirements establish a separate entity.
// ---------------------------------------------------------------------------

model Institution {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  institutionCode String            @map("institution_code") @db.VarChar(50)
  name            String            @db.VarChar(255)
  legalName       String?           @map("legal_name") @db.VarChar(255)
  institutionType String?           @map("institution_type") @db.VarChar(50)
  status          InstitutionStatus @default(ACTIVE)
  email           String?           @db.VarChar(255)
  phone           String?           @db.VarChar(30)
  website         String?           @db.VarChar(255)
  addressLine1    String?           @map("address_line1") @db.VarChar(255)
  addressLine2    String?           @map("address_line2") @db.VarChar(255)
  city            String?           @db.VarChar(100)
  state           String?           @db.VarChar(100)
  postalCode      String?           @map("postal_code") @db.VarChar(20)
  country         String?           @db.VarChar(100)
  timezone        String?           @db.VarChar(50)
  locale          String?           @db.VarChar(20)
  currency        String?           @db.VarChar(10)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  brandingProfiles           BrandingProfile[]
  brandingAssets             BrandingAsset[]
  admissionApplications      AdmissionApplication[]
  campuses                   Campus[]
  userCampusAssignments      UserCampusAssignment[]
  parentStudentRelationships ParentStudentRelationship[]
  academicYears              AcademicYear[]
  departments                Department[]
  programs                   Program[]
  courses                    Course[]
  subjects                   Subject[]
  curricula                  Curriculum[]
  semesters                  Semester[]
  calendarEvents             CalendarEvent[]
  staff                      Staff[]

  @@unique([tenantId, institutionCode])
  @@index([tenantId, status])
  @@index([tenantId])
  @@map("institutions")
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// White-label branding (Institution-owned; Tenant can hold defaults later)
// Theme templates = system reference data. Assets metadata only — binaries in S3.
// ---------------------------------------------------------------------------

model ThemeTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// JSON design tokens (colors, typography) — applied by copy into BrandingProfile
  tokensJson  Json     @map("tokens_json")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, sortOrder])
  @@map("theme_templates")
}

model BrandingProfile {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  institutionId  String    @map("institution_id") @db.Uuid
  /// DRAFT | PUBLISHED
  status         String    @default("DRAFT") @db.VarChar(20)
  displayName    String?   @map("display_name") @db.VarChar(255)
  shortName      String?   @map("short_name") @db.VarChar(100)
  welcomeMessage String?   @map("welcome_message") @db.VarChar(500)
  /// Applied template code (reference only)
  templateCode   String?   @map("template_code") @db.VarChar(50)
  /// Effective tokens JSON (copied from template + customizations)
  tokensJson     Json      @map("tokens_json")
  logoAssetId    String?   @map("logo_asset_id") @db.Uuid
  faviconAssetId String?   @map("favicon_asset_id") @db.Uuid
  loginBgAssetId String?   @map("login_bg_asset_id") @db.Uuid
  version        Int       @default(1)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  versions    BrandingVersion[]

  @@unique([institutionId, status])
  @@index([tenantId, institutionId])
  @@map("branding_profiles")
}

model BrandingVersion {
  id                String   @id @default(uuid()) @db.Uuid
  brandingProfileId String   @map("branding_profile_id") @db.Uuid
  version           Int
  status            String   @db.VarChar(20)
  tokensJson        Json     @map("tokens_json")
  summary           String?  @db.VarChar(255)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile BrandingProfile @relation(fields: [brandingProfileId], references: [id], onDelete: Cascade)

  @@unique([brandingProfileId, version])
  @@index([brandingProfileId])
  @@map("branding_versions")
}

model BrandingAsset {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  /// LOGO | FAVICON | LOGIN_BACKGROUND | WATERMARK | THEME_PREVIEW
  assetType     String   @map("asset_type") @db.VarChar(50)
  objectKey     String   @map("object_key") @db.VarChar(512)
  contentType   String   @map("content_type") @db.VarChar(100)
  sizeBytes     Int      @map("size_bytes")
  checksum      String?  @db.VarChar(128)
  originalName  String?  @map("original_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([tenantId, institutionId, assetType])
  @@map("branding_assets")
}

// ---------------------------------------------------------------------------
// Admissions CRM foundation (Sprint 1)
// Application pipeline only — enrollment/student record creation is later SIS phase.
// ---------------------------------------------------------------------------

model AdmissionApplication {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  institutionId   String          @map("institution_id") @db.Uuid
  /// Authenticated applicant who owns this application (nullable for staff-created CRM records)
  applicantUserId String?         @map("applicant_user_id") @db.Uuid
  applicationNo   String          @map("application_no") @db.VarChar(50)
  status          AdmissionStatus @default(SUBMITTED)
  /// Applicant identity (pre-enrollment — not a User account unless linked later)
  firstName       String          @map("first_name") @db.VarChar(100)
  lastName        String          @map("last_name") @db.VarChar(100)
  email           String          @db.VarChar(255)
  phone           String?         @db.VarChar(30)
  dateOfBirth     DateTime?       @map("date_of_birth") @db.Date
  programApplied  String?         @map("program_applied") @db.VarChar(150)
  academicYear    String?         @map("academic_year") @db.VarChar(20)
  notes           String?         @db.VarChar(1000)
  submittedAt     DateTime?       @map("submitted_at") @db.Timestamptz
