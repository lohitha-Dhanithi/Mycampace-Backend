// ---------------------------------------------------------------------------
// HRMS — proposed Prisma models (DESIGN DRAFT, not yet merged into schema.prisma)
//
// Derived from: webapp-frontend/src/modules/hrms/{types.ts, services/hrmsService.ts,
//               config/hrmsConfig.ts} and docs/HRMS-Jira-Backlog.md
//
// To adopt: paste into schema.prisma, add the back-relations listed at the
// bottom of this file, then `prisma migrate dev --name hrms_init`.
//
// Conventions follow the existing schema: uuid PKs, tenant_id on every table,
// snake_case @map, Timestamptz, soft delete via deleted_at, UPPER_CASE enums.
// ---------------------------------------------------------------------------

// ===========================================================================
// Enums
// ===========================================================================

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  SEPARATED
}

enum HrmsLookupStatus {
  ACTIVE
  INACTIVE
}

enum StaffDocumentStatus {
  PENDING_REVIEW
  VERIFIED
  EXPIRED
}

enum CertificationStatus {
  VALID
  EXPIRING
  EXPIRED
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDecision {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Who is acting in an approval step: a reporting-chain manager or HR
enum LeaveApproverKind {
  APPLICANT
  MANAGER
  HR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum AppraisalStage {
  SELF_REVIEW
  HOD_REVIEW
  PRINCIPAL_REVIEW
  HR_CLOSED
}

enum AppraisalRating {
  OUTSTANDING
  EXCEEDS_EXPECTATIONS
  MEETS_EXPECTATIONS
  NEEDS_IMPROVEMENT
}

// ===========================================================================
// E3 — Setup lookups (HrmsSetupPage)
// Kept separate from academic `Department`: HR departments include
// non-academic units (Human Resources, Accounts, Laboratory).
// ===========================================================================

model HrmsCategory {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  /// e.g. "Teaching", "Non-Teaching". Appraisal metric templates key off this.
  name      String           @db.VarChar(100)
  isTeaching Boolean         @default(false) @map("is_teaching")
  status    HrmsLookupStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff                  Staff[]
  appraisalMetricTemplates AppraisalMetricTemplate[]

  /// Case-insensitive uniqueness: enforce via a unique index on lower(name) in the SQL migration
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("hrms_categories")
}

model HrmsDepartment {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String           @db.VarChar(150)
  /// Optional bridge to the academic Department when the HR unit is also an academic one
  academicDepartmentId String? @map("academic_department_id") @db.Uuid
  /// Head of department — used as the HOD reviewer in appraisals
  headStaffId String?        @map("head_staff_id") @db.Uuid
  status    HrmsLookupStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz

  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicDepartment Department? @relation(fields: [academicDepartmentId], references: [id], onDelete: SetNull)
  head               Staff?      @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staff              Staff[]     @relation("StaffDepartment")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("hrms_departments")
}

// ===========================================================================
// E2 — Staff directory (StaffListPage / StaffFormPage / StaffDetailPage)
// ===========================================================================

model Staff {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  campusId       String      @map("campus_id") @db.Uuid
  /// Linked platform login. Resolved by email for My Portal (`ensureSelfStaff`).
  userId         String?     @map("user_id") @db.Uuid
  /// EMP-#### generated per tenant
  employeeCode   String      @map("employee_code") @db.VarChar(30)
  fullName       String      @map("full_name") @db.VarChar(200)
  email          String      @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  categoryId     String      @map("category_id") @db.Uuid
  departmentId   String      @map("department_id") @db.Uuid
  designation    String      @db.VarChar(150)
  /// Frontend stores the manager's NAME; the API must use this FK instead.
  /// Null = reports to Principal / top of chain (leave goes straight to HR).
  reportingManagerId String? @map("reporting_manager_id") @db.Uuid
  joiningDate    DateTime    @map("joining_date") @db.Date
  separationDate DateTime?   @map("separation_date") @db.Date
  status         StaffStatus @default(ACTIVE)
  qualification  String?     @db.VarChar(255)
  experienceYears Decimal    @default(0) @map("experience_years") @db.Decimal(4, 1)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus         Campus         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  category       HrmsCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department     HrmsDepartment @relation("StaffDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  reportingManager Staff?       @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports  Staff[]        @relation("ReportingLine")
  headedDepartments HrmsDepartment[] @relation("DepartmentHead")

  documents        StaffDocument[]
  serviceEvents    ServiceEvent[]
  certifications   Certification[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]        @relation("LeaveApplicant")
  pendingApprovals LeaveRequest[]        @relation("LeaveCurrentApprover")
  leaveSteps       LeaveApprovalStep[]
  shiftAssignments ShiftAssignment[]
  attendance       AttendanceRecord[]
  appraisals       AppraisalReview[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, campusId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, categoryId])
  @@index([reportingManagerId])
  @@map("staff")
}

model StaffDocument {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  staffId      String              @map("staff_id") @db.Uuid
  /// Appointment Letter | Aadhaar | PAN | Degree Certificate | Experience Letter | ID Proof
  type         String              @db.VarChar(60)
  name         String              @db.VarChar(255)
  /// Object-storage key. The vault holds identity documents (Aadhaar, PAN):
  /// encrypt at rest, restrict to HR admin, and never log the identifier values.
  storageKey   String?             @map("storage_key") @db.VarChar(500)
  mimeType     String?             @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz
  uploadedById String?             @map("uploaded_by_id") @db.Uuid
  expiryDate   DateTime?           @map("expiry_date") @db.Date
  status       StaffDocumentStatus @default(PENDING_REVIEW)
  verifiedById String?             @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  /// Dashboard "expiring items"
  @@index([tenantId, expiryDate])
  @@map("staff_documents")
}

/// Service history: Joined, Promoted, Transferred, Confirmed, Separated...
model ServiceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  eventDate   DateTime @map("event_date") @db.Date
  title       String   @db.VarChar(200)
  detail      String?  @db.VarChar(1000)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, eventDate])
  @@map("service_events")
}

model Certification {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  staffId    String              @map("staff_id") @db.Uuid
  name       String              @db.VarChar(200)
  issuer     String?             @db.VarChar(200)
  issuedOn   DateTime?           @map("issued_on") @db.Date
  validUntil DateTime?           @map("valid_until") @db.Date
  /// Derive EXPIRING/EXPIRED from validUntil in a nightly job; stored for filtering
  status     CertificationStatus @default(VALID)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?           @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId])
  @@index([tenantId, validUntil])
  @@map("certifications")
}

// ===========================================================================
// E4 — Leave management (LeaveListPage / LeaveFormPage / LeaveDetailPage)
// ===========================================================================

/// Leave type master. Frontend hardcodes Casual / Sick / Earned / On Duty /
/// Compensatory Off; new staff get Casual 12, Sick 8, Earned 12.
model LeaveType {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  code             String           @db.VarChar(30)
  name             String           @db.VarChar(100)
  /// Default annual entitlement applied when balances are initialised. Null = no balance tracked (e.g. On Duty).
  defaultEntitlement Decimal?       @map("default_entitlement") @db.Decimal(5, 1)
  /// Whether approval deducts from LeaveBalance
  deductsBalance   Boolean          @default(true) @map("deducts_balance")
  status           HrmsLookupStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("leave_types")
}

model LeaveBalance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  leaveTypeId    String   @map("leave_type_id") @db.Uuid
  /// Balances reset per academic year
  academicYearId String   @map("academic_year_id") @db.Uuid
  entitled       Decimal  @db.Decimal(5, 1)
  /// Incremented on HR approval. remaining = entitled - used (compute, don't store).
  used           Decimal  @default(0) @db.Decimal(5, 1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([staffId, leaveTypeId, academicYearId])
  @@index([tenantId, academicYearId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  staffId           String             @map("staff_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  academicYearId    String             @map("academic_year_id") @db.Uuid
  fromDate          DateTime           @map("from_date") @db.Date
  toDate            DateTime           @map("to_date") @db.Date
  /// Inclusive day count, computed server-side (never trust the client)
  days              Decimal            @db.Decimal(5, 1)
  reason            String             @db.VarChar(1000)
  status            LeaveRequestStatus @default(PENDING_MANAGER)
  /// Set while PENDING_MANAGER; null when PENDING_HR (HR queue) or closed
  currentApproverId String?            @map("current_approver_id") @db.Uuid
  appliedAt         DateTime           @default(now()) @map("applied_at") @db.Timestamptz
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz
  /// Set when HR deducts balance, so a cancel/reversal can restore it exactly once
  balanceDeducted   Boolean            @default(false) @map("balance_deducted")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff           Staff               @relation("LeaveApplicant", fields: [staffId], references: [id], onDelete: Restrict)
  currentApprover Staff?              @relation("LeaveCurrentApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)
  leaveType       LeaveType           @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  steps           LeaveApprovalStep[]

  @@index([tenantId, status, appliedAt])
  @@index([tenantId, staffId, fromDate])
  /// Manager inbox: status = PENDING_MANAGER AND current_approver_id = me
  @@index([tenantId, currentApproverId, status])
  @@map("leave_requests")
}

/// Timeline: Submitted → each manager → HR. Append-only.
model LeaveApprovalStep {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  leaveRequestId String            @map("leave_request_id") @db.Uuid
  sequence       Int
  approverKind   LeaveApproverKind @map("approver_kind")
  /// Null when HR acts as a role rather than as a named staff member
  actorStaffId   String?           @map("actor_staff_id") @db.Uuid
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  /// Snapshot of display name at time of action (staff may be renamed/separated later)
  actorName      String            @map("actor_name") @db.VarChar(200)
  decision       LeaveDecision
  comment        String?           @db.VarChar(1000)
  actedAt        DateTime          @default(now()) @map("acted_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  actorStaff   Staff?       @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, sequence])
  @@index([tenantId, leaveRequestId])
  @@map("leave_approval_steps")
}

// ===========================================================================
// E6 — Shifts & attendance (AttendancePage)
// ===========================================================================

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  name      String   @db.VarChar(100)
  /// "HH:mm" wall-clock times in the campus timezone. Overnight shifts: endTime < startTime.
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  /// Minutes after startTime before check-in is marked LATE
  graceMinutes Int    @default(15) @map("grace_minutes")
  status    HrmsLookupStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campus      Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]
  attendance  AttendanceRecord[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId, status])
  @@map("shifts")
}

/// Drives the "assigned" count shown on each shift card
model ShiftAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([shiftId, staffId, effectiveFrom])
  @@index([tenantId, staffId, effectiveFrom])
  @@map("shift_assignments")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  staffId        String           @map("staff_id") @db.Uuid
  campusId       String           @map("campus_id") @db.Uuid
  shiftId        String?          @map("shift_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  checkInAt      DateTime?        @map("check_in_at") @db.Timestamptz
  checkOutAt     DateTime?        @map("check_out_at") @db.Timestamptz
  /// Set when status = ON_LEAVE from an approved request
  leaveRequestId String?          @map("leave_request_id") @db.Uuid
  /// MANUAL (HR grid) | LEAVE_SYNC | DEVICE — leaves room for biometric/geo later
  source         String           @default("MANUAL") @db.VarChar(20)
  remarks        String?          @db.VarChar(500)
  markedById     String?          @map("marked_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  shift  Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([staffId, attendanceDate])
  @@index([tenantId, attendanceDate, status])
  @@index([tenantId, campusId, attendanceDate])
  @@map("attendance_records")
}

// ===========================================================================
// E7 — Performance appraisal (AppraisalListPage / AppraisalDetailPage)
// Flow: Self → HOD → Principal → HR Closed. 1–5 scores per metric.
// final = mean(self, hod, principal) of the weighted scores.
// Rating bands: >=4.5 Outstanding, >=3.8 Exceeds, >=3.0 Meets, else Needs Improvement.
// ===========================================================================

model AppraisalCycle {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  /// e.g. "Annual Appraisal 2026-27"
  name           String   @db.VarChar(150)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isOpen         Boolean  @default(true) @map("is_open")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  reviews      AppraisalReview[]

  @@unique([tenantId, name])
  @@index([tenantId, isOpen])
  @@map("appraisal_cycles")
}

/// Template metrics per staff category (TEACHING_METRICS / NON_TEACHING_METRICS).
/// Copied into AppraisalReviewMetric when a review is created.
model AppraisalMetricTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String   @db.VarChar(150)
  /// Weights for a category should sum to 100 (validate in service)
  weight     Int
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category HrmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([tenantId, categoryId])
  @@map("appraisal_metric_templates")
}

model AppraisalReview {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  cycleId        String          @map("cycle_id") @db.Uuid
  staffId        String          @map("staff_id") @db.Uuid
  stage          AppraisalStage  @default(SELF_REVIEW)
  selfScore      Decimal?        @map("self_score") @db.Decimal(3, 1)
  hodScore       Decimal?        @map("hod_score") @db.Decimal(3, 1)
  principalScore Decimal?        @map("principal_score") @db.Decimal(3, 1)
  finalScore     Decimal?        @map("final_score") @db.Decimal(3, 1)
  finalRating    AppraisalRating? @map("final_rating")
  closedAt       DateTime?       @map("closed_at") @db.Timestamptz
  closedById     String?         @map("closed_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cycle    AppraisalCycle         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  staff    Staff                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  metrics  AppraisalReviewMetric[]
  comments AppraisalComment[]

  @@unique([cycleId, staffId])
  @@index([tenantId, cycleId, stage])
  @@index([tenantId, staffId])
  @@map("appraisal_reviews")
}

model AppraisalReviewMetric {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  reviewId   String  @map("review_id") @db.Uuid
  name       String  @db.VarChar(150)
  /// Snapshot of weight at creation so later template edits don't alter closed reviews
  weight     Int
  sortOrder  Int     @default(0) @map("sort_order")
  /// 1–5; null until that stage has scored (enforce CHECK 1..5 in migration)
  selfScore      Int? @map("self_score") @db.SmallInt
  hodScore       Int? @map("hod_score") @db.SmallInt
  principalScore Int? @map("principal_score") @db.SmallInt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  review AppraisalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, name])
  @@index([reviewId])
  @@map("appraisal_review_metrics")
}

model AppraisalComment {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  reviewId      String         @map("review_id") @db.Uuid
  stage         AppraisalStage
  authorUserId  String?        @map("author_user_id") @db.Uuid
  comment       String         @db.VarChar(2000)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  review AppraisalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@map("appraisal_comments")
}

