# Server Port
PORT=4000
NODE_ENV=development

# Frontend Client Origin for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL (embedded-postgres via npm run db:setup, or docker-compose, or RDS)
DATABASE_URL="postgresql://mycampace_user:mycampace_secure_password_2026@localhost:5432/mycampace_db?schema=public"

# Redis Cache (ElastiCache Compatible)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Single Identity Platform
JWT_SECRET="mycampace_enterprise_jwt_secret_key_2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS="30"

# Google OAuth SSO Credentials (Optional for production)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Session cookies (auth tokens are HttpOnly cookies, never returned in JSON)
# CORS_ORIGIN must list the exact frontend origin(s), e.g. http://localhost:3000 for `next dev`.
# COOKIE_SAMESITE=lax        # lax (default) | strict | none (none requires HTTPS)
# COOKIE_SECURE=true         # defaults to true in production
# COOKIE_DOMAIN=             # e.g. .mycampace.com when frontend and API are on sibling subdomains

# Email (used for institution approval / decline notices). Leave SMTP_HOST empty to skip sending (logged only).
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="MyCampace <no-reply@your-domain.com>"
# APP_BASE_URL=http://localhost:3000   # sign-in link used in emails
